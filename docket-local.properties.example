# Copy this file to docket-local.properties (same folder as pom.xml) and fill in your values.
# docket-local.properties is ignored by Git, so passwords here never go to GitHub.

# ---- Email (Gmail example) ----
# 1. Turn on 2-Step Verification for the Gmail account.
# 2. Create an App Password: Google Account > Security > App passwords.
# 3. Put the 16-character app password below (not your normal Gmail password).
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your.address@gmail.com
spring.mail.password=your-16-char-app-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Address teachers open from the email link. localhost only works on this computer;
# use this computer's network address (e.g. http://192.168.1.20:8080) for others on the same Wi-Fi.
docket.public-url=http://localhost:8080
# Only accept teachers' college emails, e.g. thapar.edu (leave empty while testing)
docket.supervisor.allowed-email-domain=

# ---- UPI ----
# The institute's real UPI ID that fees are paid to. Empty = demo ID that UPI apps refuse.
docket.payment.upi-id=
docket.payment.upi-name=TIET Fees

# ---- Razorpay (optional, test mode keys) ----
docket.payment.razorpay.key-id=
docket.payment.razorpay.key-secret=
